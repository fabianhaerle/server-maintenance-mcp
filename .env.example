# Server Maintenance MCP — environment variables
# Copy to .env and edit. These override settings in config.yaml.

# Bearer token for authenticating MCP clients (required for HTTP/SSE)
MAINT_AUTH_TOKEN=change-me-to-a-long-random-string

# Bind address (default: 127.0.0.1)
MAINT_HOST=127.0.0.1

# Port (default: 8000)
MAINT_PORT=8000

# Comma-separated additional log directories to allow
MAINT_EXTRA_LOG_DIRS=/var/log/nginx,/opt/myapp/logs

# Max log lines per call (default: 1000)
MAINT_MAX_LOG_LINES=1000

# Default log lines when not specified (default: 100)
MAINT_DEFAULT_LOG_LINES=100

# Path to a custom config file (default: auto-discovered)
# MAINT_CONFIG_FILE=/etc/server-maintenance-mcp/config.yaml
